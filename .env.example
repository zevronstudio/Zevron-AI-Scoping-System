DATABASE_URL=sqlite:///./zevron.db

# LLM Provider Configuration (OpenAI or any OpenAI-compatible API)
# Options: 'openai', 'local' (vLLM / Ollama / LM Studio), or other hosted providers
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_openai_or_llm_api_key_here
LLM_MODEL=gpt-4o

# Optional fallback variable for standard OpenAI keys
OPENAI_API_KEY=

FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
AGENT_TIMEOUT_SECONDS=120

# Frontend server proxy destination
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_PRODUCT_NAME=Zevron Scope

# Required only by Docker Compose if running PostgreSQL
POSTGRES_PASSWORD=your_secure_postgres_password_here
